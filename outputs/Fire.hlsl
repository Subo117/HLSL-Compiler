// ==================================================================
// HLSL Shader: Fire
// Generated by mysh Compiler (Domain Specific Shader Language)
// Phases executed: Lexer -> Parser -> Semantic -> Codegen
// ==================================================================

cbuffer ShaderProperties : register(b0)
{
    // Base color: orange
    float4 _BaseColor = float4(1.000f, 0.500f, 0.000f, 1.000f);

    // Procedural noise parameters
    float  _NoiseScale = 5.000f;
    float  _NoiseSpeed = 2.000f;

    // Visual effect parameters
    float  _Distortion = 0.200f;
    float  _Emission   = 2.000f;
    float  _Time       = 0.0f;
};

// Vertex Input Structure
struct VS_INPUT
{
    float3 position : POSITION;
    float2 uv       : TEXCOORD0;
};

// Pixel Shader Input Structure
struct PS_INPUT
{
    float4 position : SV_POSITION;
    float2 uv       : TEXCOORD0;
};

// ------------------------------------------------------------------
// Helper Functions: Procedural Value Noise
// ------------------------------------------------------------------
float hash21(float2 p)
{
    p = frac(p * float2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return frac(p.x * p.y);
}

float simpleNoise(float2 uv)
{
    float2 id = floor(uv);
    float2 f = frac(uv);
    f = f * f * (3.0 - 2.0 * f); // Hermite smooth interpolation

    float bl = hash21(id);
    float br = hash21(id + float2(1.0, 0.0));
    float tl = hash21(id + float2(0.0, 1.0));
    float tr = hash21(id + float2(1.0, 1.0));

    return lerp(lerp(bl, br, f.x), lerp(tl, tr, f.x), f.y);
}

// ------------------------------------------------------------------
// Vertex Shader: VSMain
// ------------------------------------------------------------------
PS_INPUT VSMain(VS_INPUT input)
{
    PS_INPUT output;
    output.position = float4(input.position, 1.0f);
    output.uv = input.uv;
    return output;
}

// ------------------------------------------------------------------
// Pixel Shader: PSMain
// ------------------------------------------------------------------
float4 PSMain(PS_INPUT input) : SV_TARGET
{
    float2 uv = input.uv;

    // Calculate procedural noise pattern with scale and animated speed
    float noiseSample = simpleNoise(uv * _NoiseScale + float2(0.0, _Time * _NoiseSpeed));

    // Apply distortion based on noise value
    float2 distortedUV = uv + (noiseSample - 0.5f) * _Distortion;
    float distortedNoise = simpleNoise(distortedUV * _NoiseScale);

    // Base color modulated by noise
    float4 finalColor = _BaseColor * (0.4f + 0.6f * distortedNoise);

    // Apply emission intensity boost
    finalColor.rgb += _BaseColor.rgb * _Emission;

    return saturate(finalColor);
}
